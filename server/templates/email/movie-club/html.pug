doctype html
head
  meta(charset='utf-8')
  meta(name='x-apple-disable-message-reformatting')
  meta(http-equiv='x-ua-compatible' content='ie=edge')
  meta(name='viewport' content='width=device-width, initial-scale=1')
  meta(name='format-detection' content='telephone=no, date=no, address=no, email=no')
  style.
    .title:hover {
    text-decoration: underline !important;
    }
    @media only screen and (max-width:600px) {
    table.wrapper {
    width: 100% !important;
    }
    td.mobile-stack {
    display: block !important;
    width: 100% !important;
    }
    img.poster {
    width: 96px !important;
    }
    }
div(style='display: block; background-color: #050505; padding: 2.5rem 0;')
  table.wrapper(style='margin: 0 auto; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Helvetica Neue", Arial, sans-serif; color: #fff; font-size: 16px; width: 34rem;')
    tr
      td(style='text-align: center;')
        if applicationUrl
          a(href=applicationUrl style='color: #fff; text-decoration: none;')
            div(style='font-size: 2.4em; line-height: 1; font-weight: 800; letter-spacing: 0;')
              | #{applicationTitle}
        else
          div(style='font-size: 2.4em; line-height: 1; font-weight: 800; letter-spacing: 0;')
            | #{applicationTitle}
        div(style='display: inline-block; margin-top: .75rem; padding: .2rem .55rem; border: 1px solid #d97706; border-radius: .375rem; color: #fbbf24; font-size: .8em; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;')
          | Plus Edition Movie Club
    if recipientName !== recipientEmail
      tr
        td(style='text-align: center;')
          div(style='margin: 1.5rem 0 0; font-size: 1.15em; color: #e5e7eb;')
            | #{labels.greeting}, #{recipientName.replace(/\.|@/g, ((x) => x + '\ufeff'))}!
    tr
      td
        div(style='box-sizing: border-box; margin: 1.5rem 0 0; border-radius: .75rem; border: 1px solid #92400e; background: #111827; padding: 1.25rem;')
          div(style='font-size: 1.35em; line-height: 1.25; font-weight: 800; color: #fff;')
            | #{subject}
          div(style='margin-top: .75rem; color: #d1d5db; line-height: 1.55; white-space: pre-line;')
            | #{body}
          if actionUrl
            a(href=actionUrl style='display: block; margin-top: 1.25rem; text-decoration: none;')
              span(style='display: block; box-sizing: border-box; border-radius: .5rem; border: 1px solid #f59e0b; background: #b45309; color: #fff; font-weight: 700; line-height: 2.5rem; text-align: center;')
                | #{actionLabel}
    if movies && movies.length
      tr
        td
          div(style='margin: 1.5rem 0 .5rem; color: #f9fafb; font-weight: 800; font-size: 1.1em;')
            | #{labels.sectionTitle}
      each movie in movies
        tr
          td
            table(style='box-sizing: border-box; width: 100%; margin: .75rem 0 0; border-radius: .75rem; border: 1px solid #374151; background: #111827; color: #fff;')
              tr
                if movie.imageUrl
                  td.mobile-stack(style='width: 7rem; vertical-align: top; padding: .9rem;')
                    if movie.actionUrl
                      a(href=movie.actionUrl)
                        img.poster(src=movie.imageUrl alt='' style='display: block; width: 6rem; border-radius: .4rem; border: 0;')
                    else
                      img.poster(src=movie.imageUrl alt='' style='display: block; width: 6rem; border-radius: .4rem; border: 0;')
                td.mobile-stack(style='vertical-align: top; padding: .9rem;')
                  if movie.actionUrl
                    a.title(href=movie.actionUrl style='color: #fff; font-size: 1.1em; line-height: 1.25; font-weight: 800; text-decoration: none;')
                      | #{movie.title}
                  else
                    div(style='color: #fff; font-size: 1.1em; line-height: 1.25; font-weight: 800;')
                      | #{movie.title}
                  if movie.releaseDate
                    div(style='margin-top: .25rem; color: #9ca3af; font-size: .9em;')
                      | #{labels.releaseDate}: #{movie.releaseDate}
                  if typeof movie.voteCount === 'number'
                    div(style='margin-top: .25rem; color: #9ca3af; font-size: .9em;')
                      | #{labels.votes}: #{movie.voteCount}
                  if movie.requestedBy
                    div(style='margin-top: .25rem; color: #9ca3af; font-size: .9em;')
                      | #{labels.requestedBy}: #{movie.requestedBy}
                  if movie.overview
                    div(style='margin-top: .75rem; color: #d1d5db; font-size: .95em; line-height: 1.45;')
                      | #{movie.overview}
                  if movie.actionUrl
                    a(href=movie.actionUrl style='display: inline-block; margin-top: .85rem; color: #fbbf24; font-weight: 700; text-decoration: none;')
                      | #{labels.readSynopsis}
    tr
      td(style='text-align: center;')
        div(style='margin-top: 2rem; color: #6b7280; font-size: .85em; line-height: 1.5;')
          | #{labels.footer}
